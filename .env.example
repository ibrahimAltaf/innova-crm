SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Encrypt mailbox passwords at rest (any long random string).
EMAIL_CREDENTIALS_KEY=change-me-credentials-key

# Redis + Celery (required for production sending)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Global pace between worker sends (seconds). Slow is intentional.
MAIL_SEND_INTERVAL_SECONDS=8
MAIL_DEFAULT_DAILY_LIMIT=300
MAIL_DEFAULT_HOURLY_LIMIT=50
MAIL_SENDER_COOLDOWN_SECONDS=900
MAIL_MAX_ATTEMPTS=8

# Optional fallback mailbox if the sender pool is empty
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=info@example.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@example.com
DEFAULT_FROM_NAME=Your Company
REPLY_TO_EMAIL=info@example.com
SITE_URL=http://127.0.0.1:8000

# Preferred: store each mailbox password in its own env var and set
# SenderAccount.credential_env_key to that name, e.g. SMTP_PASSWORD_INFO
# SMTP_PASSWORD_INFO=
# SMTP_PASSWORD_HELLO=
