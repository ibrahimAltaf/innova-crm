SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Hostinger mailbox example (port 465 = SSL). Put the real mailbox password in EMAIL_HOST_PASSWORD.
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=info@yourdomain.com
EMAIL_HOST_PASSWORD=your-mailbox-password
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=info@yourdomain.com
DEFAULT_FROM_NAME=Your Company
REPLY_TO_EMAIL=info@yourdomain.com

SITE_URL=http://127.0.0.1:8000

USE_POSTGRES=false
POSTGRES_DB=innovacrm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

